{
	"name": "@cdd-team/workbox-build",
	"version": "0.1.0",
	"description": "Генератор самостоятельного sw.js с precache и офлайн-fallback навигации, без Vite",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cringe-Driven-Development-Team/frontend-packages.git",
		"directory": "packages/workbox-build"
	},
	"keywords": [
		"service-worker",
		"pwa",
		"precache",
		"build"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"lint": "oxlint -c ../../oxlint.config.ts src",
		"fmt:check": "oxfmt -c ../../oxfmt.config.ts --check src",
		"typecheck": "tsc --noEmit",
		"build": "tsdown"
	},
	"dependencies": {
		"@cdd-team/workbox": "^0.1.0"
	},
	"devDependencies": {
		"@types/node": "24.10.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
