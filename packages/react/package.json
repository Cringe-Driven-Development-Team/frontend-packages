{
	"name": "@cdd-team/react",
	"version": "1.4.0",
	"description": "Учебная реализация React",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cringe-Driven-Development-Team/frontend-packages.git",
		"directory": "packages/react"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.mts",
			"import": "./dist/jsx-runtime.mjs"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.mts",
			"import": "./dist/jsx-dev-runtime.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"lint": "oxlint -c ../../oxlint.config.ts src test",
		"fmt:check": "oxfmt -c ../../oxfmt.config.ts --check src test",
		"typecheck": "tsc --noEmit",
		"test": "bun test --preload ./test/setup-dom.ts test",
		"build": "tsdown"
	},
	"publishConfig": {
		"access": "public"
	}
}
