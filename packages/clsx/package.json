{
	"name": "@cdd-team/clsx",
	"version": "0.2.0",
	"description": "Сборка строки CSS-классов из строк, массивов и объектов-условий",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cringe-Driven-Development-Team/frontend-packages.git",
		"directory": "packages/clsx"
	},
	"keywords": [
		"clsx",
		"classnames",
		"css"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"lint": "oxlint -c ../../oxlint.config.ts src test",
		"fmt:check": "oxfmt -c ../../oxfmt.config.ts --check src test",
		"typecheck": "tsc --noEmit",
		"test": "bun test test",
		"build": "tsdown"
	},
	"publishConfig": {
		"access": "public"
	}
}
