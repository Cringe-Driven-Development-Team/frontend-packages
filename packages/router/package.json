{
	"name": "@cdd-team/router",
	"version": "0.2.0",
	"description": "Роутер для @cdd-team/react с API по образцу TanStack Router",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cringe-Driven-Development-Team/frontend-packages.git",
		"directory": "packages/router"
	},
	"keywords": [
		"router",
		"routing",
		"history"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"lint": "oxlint -c ../../oxlint.config.ts src test",
		"fmt:check": "oxfmt -c ../../oxfmt.config.ts --check src test",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/register",
		"test": "bun test --preload ./test/setup-dom.ts test",
		"build": "tsdown"
	},
	"dependencies": {
		"@cdd-team/clsx": "^0.1.1"
	},
	"peerDependencies": {
		"@cdd-team/react": "^1.7.1"
	},
	"devDependencies": {
		"@cdd-team/react": "^1.7.1",
		"@happy-dom/global-registrator": "^20.14.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
