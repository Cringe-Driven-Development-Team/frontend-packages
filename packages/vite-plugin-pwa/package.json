{
	"name": "@cdd-team/vite-plugin-pwa",
	"version": "0.1.0",
	"description": "Плагин Vite: манифест PWA и самостоятельный sw.js из явного списка файлов сборки",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cringe-Driven-Development-Team/frontend-packages.git",
		"directory": "packages/vite-plugin-pwa"
	},
	"keywords": [
		"vite",
		"vite-plugin",
		"pwa",
		"service-worker",
		"manifest"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"lint": "oxlint -c ../../oxlint.config.ts src test",
		"fmt:check": "oxfmt -c ../../oxfmt.config.ts --check src test",
		"typecheck": "tsc --noEmit",
		"test": "bun test test",
		"build": "tsdown"
	},
	"dependencies": {
		"@cdd-team/workbox-build": "^0.1.0"
	},
	"peerDependencies": {
		"vite": "^8.3.3"
	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"vite": "^8.3.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
