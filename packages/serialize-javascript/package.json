{
	"name": "@cdd-team/serialize-javascript",
	"version": "0.1.0",
	"description": "JSON для безопасной вставки в тело script в HTML",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cringe-Driven-Development-Team/frontend-packages.git",
		"directory": "packages/serialize-javascript"
	},
	"keywords": [
		"json",
		"html",
		"script",
		"xss"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"lint": "oxlint -c ../../oxlint.config.ts src",
		"fmt:check": "oxfmt -c ../../oxfmt.config.ts --check src",
		"typecheck": "tsc --noEmit",
		"build": "tsdown"
	},
	"publishConfig": {
		"access": "public"
	}
}
