{
	"name": "@cdd-team/http-client",
	"version": "0.1.1",
	"description": "Типизированный HTTP-клиент по карте операций поверх транспорта Promise<Response>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cringe-Driven-Development-Team/frontend-packages.git",
		"directory": "packages/http-client"
	},
	"keywords": [
		"http",
		"fetch",
		"typescript"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"lint": "oxlint -c ../../oxlint.config.ts src",
		"fmt:check": "oxfmt -c ../../oxfmt.config.ts --check src",
		"typecheck": "tsc --noEmit",
		"build": "tsdown"
	},
	"publishConfig": {
		"access": "public"
	}
}
