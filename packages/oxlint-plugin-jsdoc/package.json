{
	"name": "@cdd-team/oxlint-plugin-jsdoc",
	"version": "0.1.1",
	"description": "Правила oxlint про JSDoc, которых нет в его плагине jsdoc: require-jsdoc для экспортов и check-param-names",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cringe-Driven-Development-Team/frontend-packages.git",
		"directory": "packages/oxlint-plugin-jsdoc"
	},
	"keywords": ["oxlint", "oxlint-plugin", "jsdoc", "tsdoc", "lint"],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist"],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "oxlint -c ../../oxlint.config.ts src test",
		"fmt:check": "oxfmt -c ../../oxfmt.config.ts --check src test",
		"typecheck": "tsc --noEmit",
		"build": "tsdown"
	},
	"peerDependencies": {
		"oxlint": ">=1.86.0"
	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"oxlint": "^1.86.0"
	}
}
