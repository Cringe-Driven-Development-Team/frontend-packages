{
	"name": "frontend-packages",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": ["packages/*"],
	"scripts": {
		"lint": "bun run --filter './packages/*' lint",
		"fmt:check": "bun run --filter './packages/*' fmt:check",
		"typecheck": "bun run --filter './packages/*' typecheck",
		"test": "bun run --filter './packages/*' test",
		"build": "bun run --filter './packages/*' build"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2"
	}
}
